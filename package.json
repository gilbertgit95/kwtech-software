{
  "name": "kwtech-software",
  "version": "0.0.0",
  "private": true,
  "description": "KWTech software monorepo",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "node scripts/env.mjs ensure && node scripts/dev-ports.mjs && node scripts/dev-db.mjs && turbo run dev",
    "dev:api": "node scripts/env.mjs ensure && node scripts/dev-ports.mjs --ports=8080 && node scripts/dev-db.mjs && turbo run dev --filter=@kwtech/web-server...",
    "dev:web": "node scripts/env.mjs ensure && node scripts/dev-ports.mjs --ports=8081 && turbo run dev --filter=@kwtech/web-app...",
    "env:show": "node scripts/env.mjs",
    "env:use": "node scripts/env.mjs use",
    "env:new": "node scripts/env.mjs new",
    "env:check": "node scripts/env.mjs check",
    "dev:stop": "node scripts/dev-ports.mjs",
    "dev:ports": "node scripts/dev-ports.mjs --list",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:up": "node scripts/dev-db.mjs",
    "db:down": "node scripts/dev-db.mjs --stop",
    "db:generate": "turbo run db:generate",
    "db:validate": "turbo run db:validate",
    "db:migrate": "pnpm --filter @kwtech/web-server db:migrate",
    "db:deploy": "pnpm --filter @kwtech/web-server db:deploy",
    "db:studio": "pnpm --filter @kwtech/web-server db:studio",
    "db:sync": "pnpm --filter @kwtech/web-server db:sync",
    "db:seed": "pnpm --filter @kwtech/web-server db:seed",
    "db:snapshot": "pnpm --filter @kwtech/web-server db:snapshot",
    "db:restore": "pnpm --filter @kwtech/web-server db:restore",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "lefthook": "2.1.10",
    "turbo": "2.10.8",
    "typescript": "catalog:"
  }
}
