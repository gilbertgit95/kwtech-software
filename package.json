{
  "name": "kwtech-software",
  "version": "0.0.0",
  "private": true,
  "description": "KWTech software monorepo",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@kwtech/web-server...",
    "dev:web": "turbo run dev --filter=@kwtech/web-app...",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "turbo run db:generate",
    "db:validate": "turbo run db:validate",
    "db:migrate": "pnpm --filter @kwtech/db db:migrate",
    "db:deploy": "pnpm --filter @kwtech/db db:deploy",
    "db:studio": "pnpm --filter @kwtech/db db:studio",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "lefthook": "2.1.10",
    "turbo": "2.10.8",
    "typescript": "catalog:"
  }
}
