{
  "$schema": "https://turbo.build/schema.json",

  // Catalog versions live in pnpm-workspace.yaml, so a change there genuinely
  // affects every task. .env is deliberately NOT a global dependency — no
  // cached task reads one, and listing it would make every secret edit
  // invalidate the entire cache universe. DATABASE_URL is likewise not global;
  // it is passed to the tasks that genuinely need it.
  "globalDependencies": ["pnpm-workspace.yaml"],
  "globalEnv": ["NODE_ENV"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // src/generated/** is the Prisma client (TypeScript source under Prisma
      // 7). It must be in outputs or a cache restore yields a package that
      // cannot compile.
      "outputs": ["dist/**", "src/generated/**"],
      // prisma.config.ts resolves env('DATABASE_URL') eagerly, so generate
      // fails without it even though it never opens a connection.
      // passThroughEnv, not env: the URL reaches the task but stays out of the
      // cache key, because only the schema affects the generated client.
      "passThroughEnv": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },

    // Long-running by nature: never cached, never awaited.
    //
    // `dependsOn: ["^build"]` is what makes `pnpm dev` work from a clean
    // checkout: every package is compiled ONCE before any watcher starts, so an
    // app does not boot against a dist/ that does not exist yet. After that the
    // packages' own `dev` watchers take over and rebuild on change — which is
    // what makes editing a module show up in the running apps rather than only
    // after a manual build.
    //
    // Note `^build`, not `^dev`: a persistent task can never be depended upon,
    // because it does not finish.
    // A package's one-shot `build` and its `dev` watcher compile the same
    // project into the same dist/. They are given SEPARATE build-info files
    // (see each package's dev script) so the two cannot race on it — a
    // collision there makes one of them conclude "nothing changed" and emit
    // nothing, which is the failure mode that is hardest to read.
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },

    // ── contracts ─────────────────────────────────────────────────────────
    // apps/web-server is the only producer: code-first resolvers emit schema.graphql
    // and @nestjs/swagger emits openapi.json. Every consumer's codegen depends
    // on it, so the task graph — not a README — enforces the ordering.
    "schema:generate": {
      "dependsOn": ["^build"],
      "outputs": ["schema.graphql", "openapi.json"]
    },
    "codegen": {
      "dependsOn": ["@kwtech/web-server#schema:generate"],
      "outputs": ["src/generated/**"]
    },
    "codegen:watch": {
      "cache": false,
      "persistent": true
    },

    // ── database ──────────────────────────────────────────────────────────
    // All uncached: they talk to a live database, or write outside the
    // package. DATABASE_URL is declared per-task rather than globally so it
    // cannot invalidate build/lint/test.
    // Copies each module's prisma fragment into the app's schema folder. Not
    // cached: it writes outside the task's own outputs, into a directory that
    // must reflect whatever the module packages currently hold.
    "db:compose": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:validate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:deploy": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },

    // ── front end ─────────────────────────────────────────────────────────
    // Next writes .next/, not dist/, and .next/cache is its own incremental
    // cache — restoring it from turbo would be a cache inside a cache.
    // NEXT_PUBLIC_* values are inlined into the client bundle at build time,
    // so they genuinely change the output and must be part of the hash.
    "@kwtech/web-app#build": {
      // No `codegen` yet: that task appears with the GraphQL layer in Phase 3.
      // Listing a script no package has makes turbo fail the graph, not skip.
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      // API_URL and SESSION_COOKIE are SERVER-side — read by the route handlers
      // in src/app/api/auth, never inlined into the client bundle, which is the
      // whole point of not naming them NEXT_PUBLIC_. They still belong in the
      // hash: a build against a different API is a different build.
      "env": ["NEXT_PUBLIC_*", "API_URL", "SESSION_COOKIE"]
    },

    // The backend must generate its Prisma client before anything typechecks
    // against it — the client is TypeScript source, so without it there is no
    // `PrismaClient` type to extend.
    "@kwtech/web-server#build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", "src/generated/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@kwtech/web-server#typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "passThroughEnv": ["DATABASE_URL"]
    },

    // Same reason as its build: the Prisma client is TypeScript SOURCE, so
    // without generating it first there is no `PrismaClient` type to extend and
    // the watcher's first compile fails on a clean checkout.
    "@kwtech/web-server#dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
