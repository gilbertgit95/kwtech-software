{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/generated",
      "!**/.next",
      // Static assets, not source. Biome parses a standalone .svg as JSX and
      // demands a <title> on every icon — an a11y rule that belongs on inline
      // SVG in components, not on files served verbatim.
      "!**/public",
      // Written by Next on every build and stamped "should not be edited".
      // Formatting it is churn that the next build reverses.
      "!**/next-env.d.ts",
      // Emitted by Nest's code-first driver on every boot (autoSchemaFile). It
      // is committed on purpose — PLAN §6 makes it the contract the frontend
      // generates types from, so a resolver change that alters the public schema
      // shows up in review. But formatting it is churn the next boot reverses,
      // exactly like next-env.d.ts above.
      "!apps/web-server/schema.graphql",
      // Email templates. The .html files carry Eta tags (`<%= %>`), which Biome
      // reads as an unescaped `<` and rejects as a parse error — and a file it
      // cannot parse is a file it silently stops checking, so excluding them is
      // explicit rather than incidental. They are templates compiled at runtime,
      // not documents: the escaping rule that actually matters for them is
      // enforced by apps/web-server/test/render.test.ts instead.
      "!apps/web-server/src/mail/templates"
    ]
  },
  "css": {
    "parser": {
      // Tailwind v4 configures itself in CSS (@theme, @utility, @custom-variant).
      // Without this the app's globals.css is a parse error, and a file Biome
      // cannot parse is a file it silently stops checking.
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      // Every NestJS surface in the repo. Three recommended rules read Nest's
      // idioms as mistakes, and one of them silently breaks the app.
      //
      // Scoped by WHAT THE CODE IS, not by a directory that happens to be
      // called `server`: the first version of this override matched only
      // `**/src/server/**`, so the modules were protected and apps/web-server —
      // which is Nest from top to bottom — was not. `useImportType` then erased
      // the PrismaService import in HealthController and the app failed to boot
      // with "argument Function at index [0]", which names neither the file nor
      // the cause.
      "includes": ["**/src/server/**", "apps/web-server/src/**"],
      "linter": {
        "rules": {
          "style": {
            // THE IMPORTANT ONE. Nest resolves a constructor parameter from the
            // `design:paramtypes` metadata emitDecoratorMetadata writes, and
            // that metadata is emitted from the VALUE binding. Rewriting an
            // injected class to `import type` erases it, so the container has
            // nothing to resolve and the app fails at startup — a runtime
            // break produced by a lint autofix, with a clean typecheck either
            // side of it.
            "useImportType": "off"
          },
          "complexity": {
            // A Nest dynamic module IS a class with only static members:
            // `forRoot` must hang off a @Module()-decorated class. There is no
            // function form to prefer.
            "noStaticOnlyClass": "off"
          },
          "correctness": {
            // An injected dependency reserved for a handler that is not written
            // yet reads as unused. Removing the parameter would remove the
            // injection.
            "noUnusedPrivateClassMembers": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "parser": {
      // NestJS controllers cannot be written without parameter decorators —
      // @Body(), @Args() and @Req() are how a handler receives anything at all.
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded",
      "bracketSpacing": true
    }
  }
}
