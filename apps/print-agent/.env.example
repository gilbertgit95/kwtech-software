# The print agent's settings. Copy to `.env.local` beside this file (or `.env`
# on a shop's computer) and fill it in. Only API_URL and WS_URL are required.
# The agent reads the file from the folder it is run in, else from the folder
# the program is in, so a startup task needs no working folder set.
#
# ⚠ THE AGENT'S SECRET IS NOT HERE, and must never be. The server issues it
# when the computer is paired (`print-agent pair <code>`), and the agent keeps
# it in its state folder. Neither is the pairing code: it is typed once.

# Which environment this is: local | staging | production.
APP_ENV="local"

# Where the server is. The agent only ever connects OUT to these.
# ⚠ Anywhere but localhost they must be https:// and wss://, or the agent
# refuses to start: its secret would cross the network in the clear.
# ⚠ Both must name the same host and port: the secret API_URL issues is sent
# to WS_URL, and the agent refuses to send it to a different server.
API_URL="http://localhost:8080/api/v1"
WS_URL="ws://localhost:8080/api/v1/graphql"

# Where the agent keeps what pairing gave it.
# Empty: %APPDATA%\kwtech-print-agent on Windows, ~/.config/kwtech-print-agent elsewhere.
PRINT_AGENT_STATE_DIR=""

# Printers never reported, comma separated, by their exact name in the
# operating system. Empty: the ones Windows adds itself that put nothing on
# paper (Microsoft Print to PDF, Microsoft XPS Document Writer, Fax, OneNote).
# Set it to "none" to report every printer.
PRINT_AGENT_EXCLUDE_PRINTERS=""

# How the agent reads printers: "windows" asks the operating system, "fake"
# invents two (for developing where there are none, such as inside WSL).
# Empty: windows on Windows, fake anywhere else.
PRINT_AGENT_DRIVER=""

# The SumatraPDF the agent prints with. Empty: the one that comes inside the
# printing library (node_modules/pdf-to-printer). Set it only to use another.
PRINT_AGENT_SUMATRA_PATH=""
