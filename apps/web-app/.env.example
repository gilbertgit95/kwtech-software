# apps/web-app — copy to .env.local

# Where the NestJS API lives. Deliberately NOT NEXT_PUBLIC_: the browser never
# talks to the API directly, only to this app's own /api/auth route handlers,
# which hold the tokens in httpOnly cookies.
API_URL="http://localhost:8080/api/v1"

# Names the session cookie. Configurable so two deployments on sibling
# subdomains do not overwrite each other's session.
SESSION_COOKIE="kwtech_session"
