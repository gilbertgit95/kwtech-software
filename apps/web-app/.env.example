# apps/web-app — copy to .env.local

# Where the NestJS API lives. Deliberately NOT NEXT_PUBLIC_: the browser never
# talks to the API directly, only to this app's own /api/auth route handlers,
# which hold the tokens in httpOnly cookies.
API_URL="http://localhost:8080/api/v1"

# Names the session cookie. Configurable so two deployments on sibling
# subdomains do not overwrite each other's session.
#
# ⚠ AN IDENTIFIER, NOT BRANDING. It reads like a product name and is not one:
# every signed-in browser is holding a cookie under this exact name, so changing
# it signs all of them out at once. Do NOT rename it alongside APP_NAME.
SESSION_COOKIE="kwtech_session"

# ── identity ────────────────────────────────────────────────────────────────
# THE PRODUCT NAME — the wordmark in the side drawer and the browser tab. The
# two-letter mark beside it is derived from this ("KWTech" -> KW), so there is
# nothing else to update at a rename.
#
# Deliberately NOT NEXT_PUBLIC_: that prefix inlines a value at BUILD time, so
# one built image could never run under two names. It is read on the server and
# passed into the drawer as a prop instead.
#
# ⚠ apps/web-server has its OWN APP_NAME, plus MAIL_BRAND and
# AUTH_MFA_ISSUER_LABEL. Set all of them and keep them equal — two processes,
# two environments, no shared config, and nothing enforces the match.
APP_NAME="KWTech"

# The quieter second line under the wordmark. Omit it and the drawer shows one
# line rather than an empty second one.
APP_TAGLINE="Software"

# ── realtime ────────────────────────────────────────────────────────────────
# The API's WebSocket endpoint. THE ONE PUBLIC API URL, and the exception is
# forced rather than chosen: a browser opening a WebSocket connects directly,
# because a Next route handler cannot proxy an upgrade and a serverless function
# cannot hold a connection open (PLAN §5, §12.4).
#
# NEXT_PUBLIC_ inlines it at BUILD time, so changing hosts needs a redeploy.
#
# It publishes the API's ORIGIN and nothing else. The session stays in the
# httpOnly cookie: the browser mints a sixty-second ticket from
# /api/auth/ws-ticket on this app's own origin and presents that at the
# handshake, so no credential is inlined here or readable by page scripts.
#
# Unset means no realtime. Every screen that subscribes also reads over HTTP and
# works without a socket — it simply stops updating by itself.
NEXT_PUBLIC_WS_URL="ws://localhost:8080/api/v1/graphql"
