# apps/web-server — copy to .env and fill in.
# Validated at import time by src/config/env.ts: a bad value stops the boot
# with one clear line rather than failing on the first request.

# ── database ────────────────────────────────────────────────────────────────
# Must tolerate connection churn — Neon, Supabase, or PgBouncer in front of RDS
# (PLAN §5). Needed by `prisma generate` too, which reads it without connecting.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kwtech?schema=public"

# ── service ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
FRONTEND_URL="http://localhost:8081"
# Comma-separated. Defaults to FRONTEND_URL, which is right for one frontend.
# CORS_ORIGINS="http://localhost:8081,https://app.example.com"

# ── auth ────────────────────────────────────────────────────────────────────
# ⚠ RENAMED 2026-08-25: this was JWT_SECRET. Existing deployments must rename it
# — the server refuses to boot without it rather than falling back to a default
# secret every forgetful deployment would share. The name now matches the
# contract @kwtech/module-auth publishes; see packages/module-auth/docs/USAGE.md.
#
# Signs the access token. At least 32 characters:
#   openssl rand -base64 48
AUTH_JWT_SECRET="change-me-generate-with-openssl-rand-base64-48-chars-minimum"

# How long someone stays signed in. THIS is the "token expiration" knob.
# Omit it and the default below applies.
AUTH_SESSION_TTL=7d

# How long before the client silently renews against the session above.
# 5m, not 15m: this number IS the window in which a revoked or stolen access
# token still works, because verification reads no database. Lowering it costs
# more refresh calls, and that cost scales with SESSIONS rather than with
# requests — roughly 7 queries/sec per 1000 concurrent users at 5m, against
# ~170/sec if the session row were checked on every request instead.
# Keep it short: this API verifies access tokens without reading the database,
# so a revoked session stays usable until its current access token expires.
# Raising this to 7d would make "sign out everywhere" and account suspension
# take up to a week to bite.
AUTH_ACCESS_TOKEN_TTL=5m

# A reset link sits in an inbox. Short on purpose.
AUTH_PASSWORD_RESET_TTL=1h

# Where the emailed reset link points — a page in the Next app.
AUTH_RESET_URL_BASE="http://localhost:8081/auth/reset-password"

# ── seeding ─────────────────────────────────────────────────────────────────
# Two commands, two lifecycles — see src/seed/README.md:
#
#   pnpm db:sync   reference data the code owns (the feature registry, the
#                  app-level system roles). Idempotent, and it belongs on EVERY
#                  DEPLOY: perm_role_feature references perm_feature, so until it
#                  has run a newly added feature key cannot be granted to anyone.
#   pnpm db:seed   db:sync, then the once-per-environment data below.
#
# ⚠ `pnpm db:seed` REWRITES the seeded account's password from SEED_USER_PASSWORD.
# That is what makes it a manual, per-environment command rather than part of a
# deploy — run it on a live system with a stale value and you have changed
# somebody's password.
#
# There is no sign-up endpoint yet (who may create an account is undecided), so
# the first account is an explicit operator action.
SEED_USER_NAME="Gilbert D. Cuerbo"
SEED_USER_USERNAME="Gilbert95"
SEED_USER_EMAIL="gilbert.cuerbo@gmail.com"
SEED_USER_PASSWORD="Master101!"

# Optional. Set it and `pnpm db:seed` grants that address the `super-admin`
# role; leave it unset and the step is skipped. Optional rather than implied,
# because seeding roles is routine and handing someone every right on the
# platform is not — and it refuses an unknown address rather than creating one,
# so a typo cannot mint platform staff.
SEED_SUPER_ADMIN_EMAIL=""

# ── demo account for testing access checks ──────────────────────────────────
# An ordinary account holding the `normal-user` role, which grants NOTHING.
# Signing in as it is how you verify that every gated surface actually refuses:
# no Administration group in the drawer, /admin/* pages denied, and the guarded
# API endpoints rejecting the request.
#
# Skipped when unset, so the seed task is safe to run anywhere — a demo account
# appearing on production would be exactly the surprise a test fixture must not
# be capable of. Create it with `pnpm db:seed --only=demo:user`.
#
# ⚠ Leave these EMPTY here. This file is committed; apps/web-server/.env is not.
SEED_DEMO_USER_EMAIL=""
SEED_DEMO_USER_PASSWORD=""
SEED_DEMO_USER_USERNAME=""
SEED_DEMO_USER_NAME=""

# ── mail ────────────────────────────────────────────────────────────────────
# One URL, because that is the form every provider documents:
#   smtps://user:pass@smtp.provider.com:465   implicit TLS
#   smtp://user:pass@smtp.provider.com:587    STARTTLS
#   smtp://localhost:1025                     Mailpit, locally
#
# UNSET in development on purpose: without it the reset link is logged to the
# console and the flow is walkable with no mail server at all. REQUIRED in
# production — the app refuses to boot without it, because the fallback would
# write a working credential into the log aggregator.
#
# ⚠ This value carries a password. In deployment it belongs in a secret store,
# not in a committed file.
# SMTP_URL="smtp://localhost:1025"

# The From: header. Must be an address the provider has VERIFIED — an
# unverified sender is not rejected, it is silently filed as spam, which looks
# from the outside like "the email never arrived".
# A BARE address. The display name a recipient sees comes from APP_NAME,
# so a rename does not leave the old name in the From: line. Pass a full
# `Name <addr@host>` only to override that.
MAIL_FROM="no-reply@localhost"


# ── two-factor authentication ───────────────────────────────────────────────

# Encrypts TOTP secrets at rest. Unlike a password hash a TOTP secret is
# SYMMETRIC, so a stolen database row generates valid codes forever — the key
# is what keeps the dump and the secret apart, and it must not live in the
# database it protects.
#
# Optional until someone enrols a factor; enrolment refuses without it rather
# than storing a plaintext secret. 32 bytes:
#   openssl rand -base64 32
#
# Deliberately NOT the same value as AUTH_JWT_SECRET: rotating that one to
# respond to an incident would otherwise lock every 2FA user out of their
# account.
# AUTH_MFA_SECRET_KEY="change-me-generate-with-openssl-rand-base64-32"

# ── identity ────────────────────────────────────────────────────────────────
# THE PRODUCT NAME. Rename here and everything a person READS follows.
APP_NAME="KWTech"

# ── derived from APP_NAME, set explicitly so this file shows the real value ──
# Both of these fall back to APP_NAME when absent. They are written out anyway
# because an operator reading this file should be able to see what an email and
# an authenticator entry will actually say, without tracing a fallback through
# two TypeScript files.
#
# ⚠ THE COST: they are now a second place to edit at a rename. If you change
# APP_NAME above, change these too — or delete them and let the fallback work.

# The name inside a message: header, subject line, footer.
MAIL_BRAND="KWTech"

# The entry an authenticator app lists above the 6-digit code.
# Distinct per environment on purpose: with the same label everywhere, anyone
# holding a factor in both dev and production sees two identical entries and
# cannot tell them apart.
# ⚠ Changing it does NOT update factors already enrolled — the label is baked
# into the QR code at scan time.
AUTH_MFA_ISSUER_LABEL="KWTech"

# ── names that are IDENTIFIERS, not branding — do NOT rename with the product ──
# These three read like brand strings and are not. Each one is a key that
# something already-issued was matched against, so changing it is a migration,
# not a cosmetic edit:
#
#   AUTH_TOKEN_ISSUER / AUTH_TOKEN_AUDIENCE are pinned into every access token
#   and checked on every verification. Change either and every token in flight
#   fails to verify — every signed-in user is thrown out mid-session, and the
#   error is a generic 401 that says nothing about why.
#
#   SESSION_COOKIE (in apps/web-app) names the cookie. Change it and every
#   browser is still holding a cookie nobody reads any more.
#
# Set explicitly rather than left to the module's defaults, so a rename that
# sweeps this file cannot quietly take them along.
AUTH_TOKEN_ISSUER="kwtech-web-server"
AUTH_TOKEN_AUDIENCE="kwtech-api"
