# apps/web-server — copy to .env and fill in.
# Validated at import time by src/config/env.ts: a bad value stops the boot
# with one clear line rather than failing on the first request.

# ── database ────────────────────────────────────────────────────────────────
# Must tolerate connection churn — Neon, Supabase, or PgBouncer in front of RDS
# (PLAN §5). Needed by `prisma generate` too, which reads it without connecting.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kwtech?schema=public"

# ── service ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
FRONTEND_URL="http://localhost:8081"
# Comma-separated. Defaults to FRONTEND_URL, which is right for one frontend.
# CORS_ORIGINS="http://localhost:8081,https://app.example.com"

# ── auth ────────────────────────────────────────────────────────────────────
# ⚠ RENAMED 2026-08-25: this was JWT_SECRET. Existing deployments must rename it
# — the server refuses to boot without it rather than falling back to a default
# secret every forgetful deployment would share. The name now matches the
# contract @kwtech/module-auth publishes; see packages/module-auth/docs/USAGE.md.
#
# Signs the access token. At least 32 characters:
#   openssl rand -base64 48
AUTH_JWT_SECRET="change-me-generate-with-openssl-rand-base64-48-chars-minimum"

# How long someone stays signed in. THIS is the "token expiration" knob.
# Omit it and the default below applies.
AUTH_SESSION_TTL=7d

# How long before the client silently renews against the session above.
# Keep it short: this API verifies access tokens without reading the database,
# so a revoked session stays usable until its current access token expires.
# Raising this to 7d would make "sign out everywhere" and account suspension
# take up to a week to bite.
AUTH_ACCESS_TOKEN_TTL=15m

# A reset link sits in an inbox. Short on purpose.
AUTH_PASSWORD_RESET_TTL=1h

# Where the emailed reset link points — a page in the Next app.
AUTH_RESET_URL_BASE="http://localhost:8081/auth/reset-password"

# ── first user ──────────────────────────────────────────────────────────────
# There is no sign-up endpoint yet (who may create an account is undecided), so
# the first account is an explicit operator action: `pnpm db:seed`.
# Idempotent — re-running updates the password rather than failing.
SEED_USER_NAME="Gilbert D. Cuerbo"
SEED_USER_USERNAME="Gilbert95"
SEED_USER_EMAIL="gilbert.cuerbo@gmail.com"
SEED_USER_PASSWORD="Master101!"
