{
  "name": "@kwtech/web-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS API: REST today, GraphQL + graphql-ws subscriptions in Phase 3. Owns the Prisma schema and the database.",
  "scripts": {
    "db:compose": "node scripts/compose-schema.mjs",
    "db:generate": "pnpm db:compose && prisma generate",
    "db:migrate": "pnpm db:compose && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "pnpm db:generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "jest",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo src/generated prisma/_modules",
    "db:seed": "tsc -p tsconfig.build.json && node dist/seed/seed-user.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@kwtech/module-auth": "workspace:*",
    "@kwtech/module-permissions": "workspace:*",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "eta": "^4.6.0",
    "graphql": "^17.0.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "reflect-metadata": "catalog:",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "11.1.29",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "jest": "^30.0.0",
    "prisma": "^7.9.1",
    "typescript": "6.0.3"
  }
}
