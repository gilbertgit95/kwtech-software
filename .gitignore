# dependencies
node_modules
.pnp
.pnp.js

# builds
dist
build
out
.next
.turbo
# tsconfig.base.json sets "incremental": true, so every package emits one of
# these next to its tsconfig. Machine state, not source.
*.tsbuildinfo

# testing
coverage

# env
# envs/ holds every environment profile (scripts/env.mjs) — real secrets for
# local, staging and production. Only its README is committed.
envs/*
!envs/README.md
.env
.env.local
.env.*.local

# database backups
# Full pg_dump copies of a database: password hashes, sessions, MFA secrets and
# every customer row. Never committed, unlike seed-data/snapshot.json, which
# leaves credentials out on purpose. `*.dump` as well, so a backup written
# anywhere else in the tree is not one `git add .` away from being public.
backups/
*.dump
# `pnpm db:snapshot`'s export. It used to be committed as shared dev data and
# was taken out on 2026-10-24 (PLAN §13): a dev database's rows (names, emails,
# chat, tickets) do not belong in the repository, scrubbed or not. The file is
# now this machine's own; `pnpm dev` seeds a new database when it is absent.
apps/web-server/seed-data/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / os
.DS_Store
*.pem
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Prisma module fragments, copied by apps/*/scripts/compose-schema.mjs on every
# generate. A checked-in copy would be a second source that drifts from the
# module it came from.
#
# The `**/` prefixes matter: a pattern CONTAINING a slash is anchored to this
# file's directory, so a bare `prisma/_modules` would only ever match one at the
# repo root — never the one under apps/web-server, which is the only one there
# is.
**/prisma/_modules/
# Prisma 7 emits the client as TypeScript source. Generated, not authored.
**/src/generated/
test-results/
playwright-report/
