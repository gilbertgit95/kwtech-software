# The Docker install's settings (#213), beside compose.yml as `.env`.
# The installer (#133 P3) writes it; by hand: copy this to .env and fill it in.
# ⚠ Secrets are EMPTY here and generated per install, never shared:
#   openssl rand -base64 48   (AUTH_JWT_SECRET)
#   openssl rand -base64 32   (AUTH_MFA_SECRET_KEY, POSTGRES_PASSWORD)
# ⚠ Never change a secret once set: a new AUTH_JWT_SECRET signs everybody out,
#   a new AUTH_MFA_SECRET_KEY makes every two-step sign-in unreadable, and a
#   new POSTGRES_PASSWORD locks the app out of its own database.

# The release to run (exact, never moved). A rollback is this one line.
KWTECH_VERSION=""
# Where the images come from. Empty: the project's public registry.
KWTECH_IMAGES=""

# This PC's address on the shop's network (reserve it on the router).
KWTECH_HTTPS_HOST=""
# The ports published on this PC. Empty: 80 and 443.
KWTECH_HTTP_PORT=""
KWTECH_HTTPS_PORT=""

POSTGRES_PASSWORD=""
AUTH_JWT_SECRET=""
AUTH_MFA_SECRET_KEY=""

# Optional: email for password resets and invitations. Empty: no email is
# sent, and a forgotten password is set again on the server PC.
SMTP_URL=""
MAIL_FROM=""

APP_NAME=""
# The zone of backup file names and the daily 9 PM backup. Empty: Asia/Manila.
BACKUP_TIME_ZONE=""
