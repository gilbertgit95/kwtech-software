{
  "name": "@kwtech/module-backup",
  "version": "0.0.0",
  "private": true,
  "description": "Database backups: a super admin's Backups page (back up now, download, delete, restore), a daily backup process, and the command line \u2014 files in a folder, nothing in the database",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput --tsBuildInfoFile dist/.tsbuildinfo.dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@kwtech/web-ui": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "graphql": "catalog:",
    "jest": "^30.4.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@kwtech/module-kit": "workspace:*"
  },
  "peerDependencies": {
    "@kwtech/web-ui": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@kwtech/web-ui": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  }
}
