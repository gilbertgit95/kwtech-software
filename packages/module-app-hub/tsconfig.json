{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM since the React half landed. The DOMAIN half still imports none of it —
    // `src/index.ts` exports no React, and the server half no DOM.
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "outDir": "dist",
    // Inside dist/, deliberately. tsconfig.base.json turns on `incremental`, and
    // with the build info beside the tsconfig it outlives every `rm -rf dist` —
    // after which tsc concludes nothing changed and emits NOTHING. See
    // module-chat's tsconfig for the incident.
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": "src",
    // The Nest adapter uses parameter and class decorators.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
