{
  "name": "@kwtech/module-task",
  "version": "0.0.0",
  "private": true,
  "description": "Task boards per workspace, run as a sub-app on the Apps page: owner-configured columns, private or shared boards, assignees, checklists and comments",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma": "./prisma/task.prisma",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput --tsBuildInfoFile dist/.tsbuildinfo.dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@kwtech/web-ui": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "graphql": "catalog:",
    "jest": "^30.4.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@kwtech/module-kit": "workspace:*"
  },
  "peerDependencies": {
    "@kwtech/web-ui": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@kwtech/web-ui": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
