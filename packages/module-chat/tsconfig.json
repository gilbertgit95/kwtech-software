{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No DOM: this package is pure domain and runs on the server and in a test.
    "lib": ["ES2023"],
    "outDir": "dist",
    // Inside dist/, deliberately. tsconfig.base.json turns on `incremental`, and
    // with the build info beside the tsconfig it outlives every `rm -rf dist` —
    // after which tsc reads it, concludes nothing changed and emits NOTHING.
    // Silent: no error, no output, and the failure surfaces later as a
    // module-not-found pointing nowhere near the cause. Keeping it in the output
    // directory means deleting the output deletes the claim about it.
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
