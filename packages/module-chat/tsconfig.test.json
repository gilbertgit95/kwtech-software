{
  // The build config compiles src/ into dist/. This one adds test/ and emits
  // nothing, so the suite is typechecked by the same strict options as the code
  // it tests — an untypechecked test is one that can assert against a shape the
  // source no longer has and still pass.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "jest"]
  },
  "include": ["src", "test"]
}
