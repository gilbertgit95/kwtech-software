{
  "name": "@kwtech/module-platform-billing",
  "version": "0.0.0",
  "private": true,
  "description": "Billing for the whole application: an organization requests a plan, pays outside the app, and platform staff approve it; prorated plan changes with credit, grace and expiry, bills and receipts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput --tsBuildInfoFile dist/.tsbuildinfo.dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "jest": "^30.4.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@kwtech/module-kit": "workspace:*"
  }
}
