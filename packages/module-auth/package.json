{
  "name": "@kwtech/module-auth",
  "version": "0.0.0",
  "private": true,
  "description": "The authentication feature, whole: identity tables, credential and token logic, REST surface, Nest wiring and React pages",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./prisma": "./prisma/auth.prisma"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput --tsBuildInfoFile dist/.tsbuildinfo.dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "jsonwebtoken": "^9.0.0",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@kwtech/module-kit": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  }
}
