{
  "name": "@kwtech/web-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React components, the Tailwind theme and the AG Grid wrapper for the web apps",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput --tsBuildInfoFile dist/.tsbuildinfo.dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
