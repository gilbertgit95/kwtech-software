// The permissions module's slice of the data model.
//
// Composed into each consuming app's Prisma schema at generate time — this file
// is the source. Models are prefixed `Perm` and mapped to `perm_*` so a module
// can never collide with another module's names in a schema it does not own.
//
// Shape of a decision:
//
//   user ──membership──▶ organization ──subscription──▶ plan ──▶ entitlements
//                │              │                                     │
//                │              └──▶ workspace ◀── workspace member    │
//                │                       ▲                            │
//                └──▶ role grants ───────┘ (scoped, or org-wide) ──────┴──▶ allowed
//
// Both levels are shared, and sharing is explicit at both: a person joins an
// organization by PermMembership and a workspace by PermWorkspaceMember. Being
// in the organization does NOT imply seeing its workspaces, and no role widens
// that — WORKSPACE MEMBERSHIP IS REQUIRED. One rule, so "why can they see this"
// has one answer: somebody added them.
//
// Platform support is the single exemption, because a support engineer holds no
// membership anywhere and entering an organization they do not belong to is the
// entire content of the right. See domain/grants.ts.
//
// A feature is allowed when the caller's ROLES grant it — in the active
// workspace or organization-wide — AND the organization's PLAN includes it.
// Grants and entitlements are kept separate deliberately: see src/check.ts.
//
// Scope levels, deliberately only two: organization and workspace. Every extra
// level multiplies the resolution rules, and nobody can predict what a grant
// means three levels deep.

/// Enumerated rather than free-form strings. A row holding 'Active' or
/// 'organization ' would otherwise match nothing, producing a role that grants
/// nothing or a subscription that entitles nothing — with no error anywhere.
/// Silent denial is the safe direction and the undiagnosable one.
enum PermRoleLevel {
  app
  organization
  workspace
}

enum PermMembershipStatus {
  active
  invited
  suspended
}

/// Where an invitation is in its life.
///
/// `expired` is deliberately ABSENT: it is derived from `expiresAt` against the
/// clock, not stored. A stored one needs something to write it — a sweeper, or
/// a check on every read that then has to write — and an invitation that is
/// expired in fact but `pending` in the column is the kind of disagreement
/// nobody notices until somebody accepts one they should not have.
enum PermInvitationStatus {
  pending
  accepted
  /// Withdrawn by the SENDER. Distinct from `declined`, which is the invited
  /// person saying no — "who nearly let them in" and "who was asked and
  /// refused" are different facts, and one status for both would lose the
  /// difference exactly when somebody asks why they never joined.
  revoked
  /// Refused by the RECIPIENT. A dead end like the two above: inviting again is
  /// a new invitation, with a new token and a new expiry.
  declined
}

enum PermSubscriptionStatus {
  active
  past_due
  canceled
}

// ─── identity boundary ──────────────────────────────────────────────────────
// PermUser is intentionally absent: userId below is a bare string with no
// foreign key, so the users this module grants against may live in another
// module, another database or an external IdP. See docs/PLAN.md §12.12 — this
// is the open decision that most affects the model.

model PermOrganization {
  id   String @id @default(cuid())
  key  String @unique
  name String

  /// What this organization IS, in the tenant's own words.
  ///
  /// Nullable, because a description is optional and inventing one for a row
  /// that has none would be worse than an empty field. Existing rows were
  /// backfilled from `name` when the column was added, so nothing reads blank
  /// today — see the migration.
  description String?

  invitations   PermInvitation[]
  memberships   PermMembership[]
  roles         PermRole[]
  subscriptions PermSubscription[]
  workspaces    PermWorkspace[]

  @@map("perm_organization")
}

/// A workspace belongs to exactly one organization. Subscriptions do NOT live
/// here: the organization is the billing entity, so entitlement is uniform
/// across its workspaces and only the grants vary.
model PermWorkspace {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  archivedAt     DateTime?

  /// What this workspace is for. Nullable and backfilled from `name`, exactly
  /// like the organization's — see there.
  description String?

  organization PermOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       PermWorkspaceMember[]
  subscriptions PermSubscription[]

  @@unique([organizationId, key])
  @@map("perm_workspace")
}

/// Membership of one workspace, and the unit workspace-level roles hang from.
///
/// An organization has indefinitely many members; each has organization-level
/// roles. It has indefinitely many workspaces; each workspace has its own
/// members, each with workspace-level roles. So a workspace role cannot exist
/// without workspace membership — that is structural here, not a rule anyone
/// has to remember.
///
/// Keyed off the organization membership rather than the user: you cannot be in
/// a workspace of an organization you do not belong to, and routing it through
/// the membership makes that impossible to express rather than merely wrong.
model PermWorkspaceMember {
  id           String   @id @default(cuid())
  membershipId String
  workspaceId  String
  addedAt      DateTime @default(now())

  membership PermMembership            @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  workspace  PermWorkspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles      PermWorkspaceMemberRole[]

  @@unique([membershipId, workspaceId])
  @@index([workspaceId])
  @@map("perm_workspace_member")
}

/// A workspace-level role held by a workspace member.
model PermWorkspaceMemberRole {
  workspaceMemberId String
  roleId            String
  grantedAt         DateTime @default(now())

  workspaceMember PermWorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  role            PermRole            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([workspaceMemberId, roleId])
  /// ONE workspace-level role per workspace member, the same rule
  /// PermMembershipRole carries one level up — and for the same reason.
  ///
  /// A person is one thing in a workspace. Wanting the features of two roles is
  /// a reason to define a role carrying both, or to add the feature to the role
  /// they already hold — not a reason to stack two and leave "what is this
  /// person here" without an answer.
  ///
  /// The composite primary key stays and is not redundant with this: the key
  /// stops the SAME role twice, this stops two DIFFERENT ones.
  @@unique([workspaceMemberId])
  @@map("perm_workspace_member_role")
}

/// The access-relevant projection of a user: which organization they act in.
/// Permissions are always answered per (user, organization) — the same person
/// legitimately holds different rights in two organizations.
model PermMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  status         PermMembershipStatus @default(active)
  joinedAt       DateTime @default(now())

  organization PermOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        PermMembershipRole[]
  workspaces   PermWorkspaceMember[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("perm_membership")
}

// ─── roles and grants ───────────────────────────────────────────────────────

/// A role is nothing but a named collection of features that can be given to a
/// user. All the meaning lives in PermRoleFeature.
///
/// level says where the role can be used, and which features it may collect:
///
///   app          across every organization — platform staff. Granted through
///                PermUserRole, NOT through a membership, because it is not
///                scoped to any one organization.
///   organization everywhere inside one organization.
///   workspace    inside one workspace.
///
/// organizationId null = a preset shared by every organization (or an app-level
/// role, which never belongs to one). Non-null = a role that organization
/// defined for itself.
///
/// An organization- or workspace-level role may only collect features whose own
/// level matches — enforced in the service, since a workspace role quietly
/// holding `billing:manage` is a privilege escalation, not a typo.
///
/// APP-level roles are exempt and may collect any level's features. The
/// escalation above needs a lesser right to escalate from, and there is none
/// here: an app role hangs off no membership and no tenant administrator can
/// mint one. The exemption is what makes an all-access super admin expressible
/// at all — only two registry keys are app-level, so a strictly-levelled app
/// role could not read an organization's roles or fix its billing.
///
/// Note this is NOT a candidate for a SQL CHECK constraint: the rule now
/// depends on the role's level, and app rows must be allowed to hold anything.
model PermRole {
  id             String        @id @default(cuid())
  level          PermRoleLevel
  organizationId String?
  key            String
  label          String
  isSystem       Boolean @default(false)

  /// The badge drawn beside this role's name — a NAME, never a component or an
  /// SVG. Same contract as `nav.icon` on a module descriptor, and for the same
  /// reason: what 'crown' draws is the frontend's decision, so a second
  /// frontend can render the identical row in its own icon set, and the NestJS
  /// server never acquires a React dependency to store one.
  ///
  /// Nullable, and an unknown name must FALL BACK rather than throw. A role
  /// predating this column has none, and an icon retired from the app's set
  /// would otherwise turn every screen listing that role into a blank page —
  /// far worse than a generic glyph. See the app's `iconFor`.
  icon           String?

  /// Turned off without being destroyed. Null means live.
  ///
  /// There is no delete path for a role, deliberately. Every grant ever made
  /// points at this row, so deleting one either cascades the grants away —
  /// destroying the answer to "what could this person do last March" — or fails
  /// on a foreign key at the worst possible moment. The same call
  /// `PermFeature.deprecatedAt` and `AuthSession.revokedAt` already make.
  ///
  /// ⚠ A disabled role must GRANT NOTHING, and that is enforced in the read
  /// path rather than here: `PermissionsService.loadContext` filters
  /// `disabledAt: null` at all three levels. A column nothing reads would be a
  /// switch that looks like it works.
  disabledAt     DateTime?

  organization PermOrganization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Invitations naming this as the ORGANIZATION role to grant.
  invitations      PermInvitation[]
  /// Invitations naming this as the APP-level role to grant. A second relation
  /// rather than a second column on one, because they are two different offers
  /// that happen to point at the same table.
  appInvitations   PermInvitation[]         @relation("PermInvitationAppRole")
  features         PermRoleFeature[]
  limits           PermRoleLimit[]
  memberships      PermMembershipRole[]
  workspaceMembers PermWorkspaceMemberRole[]
  users            PermUserRole[]

  @@unique([organizationId, key])
  @@index([level])
  @@map("perm_role")
}

/// App-level grants: a role given to a USER outright, with no organization in
/// the picture.
///
/// Separate from PermMembershipRole because a membership is (user,
/// organization) and an app-level role has neither an organization nor a
/// workspace to hang from. Forcing it through a membership would mean inventing
/// a fake organization for staff, which then appears in every organization list
/// anyone ever queries.
model PermUserRole {
  userId    String
  roleId    String
  grantedAt DateTime @default(now())

  role PermRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@map("perm_user_role")
}

/// An organization-level role held by an organization member. Applies across
/// every workspace in that organization.
///
/// Workspace roles live on PermWorkspaceMemberRole, not here with a nullable
/// workspace column. That split is what lets both tables have honest composite
/// primary keys: a nullable column cannot be part of one, and Postgres treats
/// NULLs as distinct in a unique index, so the old shape could not stop two
/// identical organization-wide grants without a hand-written partial index.
model PermMembershipRole {
  membershipId String
  roleId       String
  grantedAt    DateTime @default(now())

  membership PermMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       PermRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  /// ONE organization-level role per member, and the database is what makes it
  /// true rather than a rule the write path is trusted to remember.
  ///
  /// A person is one thing in an organization: an owner, or an administrator,
  /// or a member. Wanting the rights of two is a reason to define a THIRD role
  /// carrying both — which `previewRoleClone` exists to make cheap — not a
  /// reason to stack two and leave "what is this person" without an answer.
  ///
  /// The composite primary key above still stands and is not redundant with
  /// this: it is what stops the same role being granted twice, and this is what
  /// stops two DIFFERENT roles. Removing either brings back a different bug.
  ///
  /// The same rule applies one level down, on PermWorkspaceMemberRole.
  /// PermUserRole — app level, platform staff — is still a collection and is
  /// the remaining open question (docs/PLAN.md §12.32).
  @@unique([membershipId])
  @@map("perm_membership_role")
}

/// The registry mirror. src/feature-keys.ts is the source; the seed task upserts
/// and marks removed keys deprecated — it never deletes, because grants and the
/// audit trail have to stay readable.
model PermFeature {
  key          String    @id
  module       String
  label        String
  description  String
  isPrivileged Boolean   @default(false)
  deprecatedAt DateTime?

  roles PermRoleFeature[]
  plans PermPlanFeature[]

  @@map("perm_feature")
}

/// A cap a role grants, as opposed to one a plan sells.
///
/// Only meaningful on APP-LEVEL roles today: 'user:organizations' — how many
/// organizations a person may belong to. That question is asked before any
/// organization exists, so there is no subscription to answer it; the user's
/// standing on the application is what decides.
///
/// Same key/value shape as PermPlanLimit so both sources resolve through one
/// registry and one map.
model PermRoleLimit {
  roleId   String
  limitKey String
  value    Int

  role PermRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, limitKey])
  @@map("perm_role_limit")
}

model PermRoleFeature {
  roleId     String
  featureKey String

  role    PermRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature PermFeature @relation(fields: [featureKey], references: [key])

  @@id([roleId, featureKey])
  @@map("perm_role_feature")
}

/// An invitation to join an organization, addressed to an EMAIL rather than to
/// a user.
///
/// It has to be its own table and cannot be a PermMembership with status
/// `invited`: a membership carries a `userId`, and the whole point of an
/// invitation is that the recipient may not have an account yet. Inventing a
/// placeholder user to hold the row would put a fake person in every count,
/// every seat cap and every members list.
///
/// The email is stored NORMALISED — trimmed, lower-cased — the same way
/// `auth_user.email` is. Storing it as typed would mean an invitation to
/// `Alice@Acme.com` never matching a sign-up as `alice@acme.com`, which is the
/// bug that only appears for the one person whose mail client capitalises.
model PermInvitation {
  id             String @id @default(cuid())
  /// The organization to join, or NULL for a PLATFORM invitation.
  ///
  /// Nullable because an invitation is an offer, and not every offer is to a
  /// tenant: an administrator inviting somebody to the platform itself — to
  /// hold an app-level role and no membership — has no organization to name.
  /// The alternative, a second table, would have duplicated the token, the
  /// expiry, the revocation and the accept page for a row differing by one
  /// column.
  ///
  /// A null here changes who may write the row: an organization invitation is
  /// `members:manage` inside that tenant, a platform one is `roles:manage_app`.
  /// See `inviteUser`.
  organizationId String?
  /// Normalised. See above.
  email          String

  /// The APP-level role to grant on acceptance.
  ///
  /// Travels on the invitation for the same reason `roleId` does: the person
  /// does not exist yet, so the role cannot be granted to them — it is decided
  /// when the invitation is written and applied when the account appears.
  ///
  /// Null for the organization invitations written before platform invitations
  /// existed, and for any written by the members screen, which does not offer
  /// one. `acceptInvitation` grants nothing when it is null.
  ///
  /// `onDelete: SetNull`, like `roleId`: retiring a role must not delete the
  /// invitations that named it.
  appRoleId      String?

  /// The organization role to grant on acceptance. Null invites them with none,
  /// which is a legitimate state — a member with no role holds nothing.
  ///
  /// `onDelete: SetNull` rather than Cascade: a role being retired must not
  /// silently delete the invitations that named it. They stay, and the person
  /// joins with no role, which is visible and fixable.
  roleId         String?

  /// Who sent it. A bare id with no foreign key, like every other user
  /// reference here — this module does not own identity (§12.12).
  invitedByUserId String

  /// The link's secret, HASHED. The token itself is handed out once, in the
  /// email, and never stored — the same rule `AuthPasswordReset` follows, and
  /// for the same reason: a database that can be read must not yield working
  /// invitations.
  tokenHash String @unique

  status     PermInvitationStatus @default(pending)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  /// Who accepted it, which need not be anybody the inviter expected — an
  /// address can be claimed by whoever reads the mailbox.
  acceptedByUserId String?
  revokedAt  DateTime?
  /// When the recipient refused. Its own column beside `acceptedAt` and
  /// `revokedAt` rather than a shared "closedAt", because the three answer
  /// different questions and a screen showing "declined 3 days ago" cannot be
  /// built from a timestamp that might mean any of them.
  declinedAt DateTime?

  organization PermOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         PermRole?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  appRole      PermRole?         @relation("PermInvitationAppRole", fields: [appRoleId], references: [id], onDelete: SetNull)

  /// NOT unique on (organizationId, email): an address that was invited,
  /// revoked and invited again is an ordinary history, and a unique index would
  /// make the second invitation impossible without deleting the first — which
  /// would destroy the record of the revocation. One PENDING invitation per
  /// address is enforced in the write path instead.
  @@index([organizationId, status])
  /// Platform invitations have no organization, so the index above cannot find
  /// the pending ones. This is what the "one live invitation per address" check
  /// reads for them.
  @@index([status, email])
  @@index([email])
  @@map("perm_invitation")
}

// ─── subscriptions and entitlements ─────────────────────────────────────────

/// A plan is a named collection of features an organization can BUY — the
/// entitlement counterpart of PermRole, which is a named collection of features
/// a person can be GIVEN. Everything a plan means is PermPlanFeature and
/// PermPlanLimit; there is no inheritance and no precedence, for the same
/// reasons a role has none.
///
/// A plan may only collect ORGANIZATION- and WORKSPACE-level features, and that
/// is not a style rule. App-level grants are unioned in AFTER the entitlement
/// filter (see domain/grants.ts), so an app-level key inside a plan entitles
/// nobody to anything: it would read as a sold feature in the catalogue while
/// changing no decision anywhere. Enforced in `assertPlanFeatureLevels`.
model PermPlan {
  key      String  @id
  label    String
  /// Whether the plan appears in a catalogue customers can see. A private plan
  /// is still fully live for whoever is already subscribed to it — this is
  /// listing, not entitlement, which is why it is not `archivedAt` below.
  isPublic Boolean @default(true)

  /// The badge drawn beside this plan's name — a NAME, never a component or an
  /// SVG. The same contract as `PermRole.icon`, and for the same reasons: what
  /// 'gem' draws is the frontend's decision, so a second frontend can render
  /// the identical row in its own icon set, and the NestJS server never
  /// acquires a React dependency to store one.
  ///
  /// Nullable, and an unknown name must FALL BACK rather than throw. A plan
  /// predating this column has none, and an icon retired from the app's set
  /// would otherwise turn every screen listing that plan into a blank page.
  ///
  /// Pure presentation, carrying NO commercial meaning:
  /// `assertPlanFeatureLevels` ignores it and nothing may branch on it. A plan
  /// is exactly the features and caps it carries — an icon implying a tier
  /// would be a second, unenforceable account of what a customer bought.
  icon     String?

  /// Retired without being destroyed. Null means live.
  ///
  /// There is no delete path for a plan, for the same reason there is none for
  /// a role: every subscription ever written points at this row, so deleting
  /// one either cascades that history away — destroying the answer to "what was
  /// this organization entitled to last March" — or fails on a foreign key at
  /// the worst possible moment. The same call `PermRole.disabledAt`,
  /// `PermFeature.deprecatedAt` and `PermWorkspace.archivedAt` already make.
  ///
  /// ⚠ An archived plan must stop entitling, and that is enforced in the READ
  /// path — `PermissionsService.loadContext` filters `plan: { archivedAt: null }`
  /// alongside the `status: 'active'` it already applied. A column nothing
  /// reads would be a switch that looks like it works.
  archivedAt DateTime?

  features      PermPlanFeature[]
  limits        PermPlanLimit[]
  subscriptions PermSubscription[]

  @@map("perm_plan")
}

/// How MANY, as opposed to what. Seats, workspaces, workspace members.
///
/// Key/value rather than typed columns so a new limit is a row, not a
/// migration — the same reason features are keys. Absent from an active plan
/// means unrestricted for that key: the plan simply does not cap it.
///
/// Deliberately separate from PermPlanFeature. A feature answers "may you do
/// this at all", a limit answers "have you room for one more" — different
/// questions, asked at different moments (read vs write), and merging them
/// makes a full organization look like an unauthorised one.
model PermPlanLimit {
  planKey String
  /// 'organization:members', 'organization:workspaces', 'workspace:members'.
  limitKey String
  value    Int

  plan PermPlan @relation(fields: [planKey], references: [key], onDelete: Cascade)

  @@id([planKey, limitKey])
  @@map("perm_plan_limit")
}

/// What a plan entitles — a plan, like a role, is a collection of features. The
/// two answer different questions and are never merged: a role says the PERSON
/// may, a plan says the ORGANIZATION (or workspace) bought it.
model PermPlanFeature {
  planKey    String
  featureKey String

  plan    PermPlan    @relation(fields: [planKey], references: [key], onDelete: Cascade)
  feature PermFeature @relation(fields: [featureKey], references: [key])

  @@id([planKey, featureKey])
  @@map("perm_plan_feature")
}

/// A subscription attaches a plan — and therefore a set of features — to an
/// organization, or to one workspace inside it.
///
///   workspaceId null = the whole organization is entitled to the plan.
///   workspaceId set  = that workspace additionally is.
///
/// The two are ADDITIVE, exactly like role grants: a workspace plan adds to
/// whatever the organization already bought, it does not replace it. Making it
/// an override would introduce a precedence rule, and precedence is the part
/// teams get wrong — a downgraded workspace plan silently revoking an
/// organization-wide entitlement is the failure that follows.
///
/// Status and period are carried here rather than fetched from the billing
/// provider on every request: a permission check must not depend on a third
/// party being reachable. The billing integration writes these rows.
model PermSubscription {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String?
  planKey        String
  status         PermSubscriptionStatus
  currentPeriodEnd DateTime?
  /// Set when superseded. Rows are kept so past entitlement can be reconstructed.
  endedAt        DateTime?

  organization PermOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    PermWorkspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan         PermPlan         @relation(fields: [planKey], references: [key])

  @@index([organizationId, status])
  @@index([workspaceId, status])
  @@map("perm_subscription")
}
