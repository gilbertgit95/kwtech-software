{
  "name": "@kwtech/module-permissions",
  "version": "0.0.0",
  "private": true,
  "description": "The permissions feature, whole: data model, domain logic, GraphQL surface, server wiring and React components",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./graphql": "./src/graphql/operations.graphql",
    "./prisma": "./prisma/permissions.prisma"
  },
  "files": [
    "dist",
    "prisma",
    "src/graphql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "jest",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@kwtech/module-kit": "workspace:*"
  }
}
