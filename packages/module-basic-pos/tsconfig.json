{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for the React half. `src/index.ts` still exports no React.
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "outDir": "dist",
    // Inside dist/, deliberately. tsconfig.base.json turns on `incremental`, and
    // with the build info beside the tsconfig it outlives every `rm -rf dist` —
    // after which tsc concludes nothing changed and emits NOTHING. See
    // module-chat's tsconfig for the incident.
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": "src"
    // No decorators yet: there is no Nest half. Turn them on with `src/server/`,
    // as module-queuing-window's tsconfig does.
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
